#include "setup.h"
#include "HardwareSerial.h"
#include "myLib/asr_ws2812.h"
#include "myLib/asr_event.h"

uint32_t snid;
void ASR_CODE();

// 语音配置区：speak / playid / ID 全部集中在程序最开头统一书写
